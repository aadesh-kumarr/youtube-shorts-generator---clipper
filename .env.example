# Required: selects viral moments and writes titles/captions.
OPENAI_API_KEY="sk-your-key-here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.4-mini"
# OPENAI_CLIPPER_MODEL="gpt-5.4"
# OPENAI_METADATA_MODEL="gpt-5.4-mini"
OPENAI_MAX_RETRIES="5"

# Local Python service included in whisper-service/.
WHISPER_BACKEND_URL="http://127.0.0.1:5000"
WHISPER_MODEL="large-v3"
WHISPER_HOTWORDS=""
WHISPER_ALLOWED_LANGUAGES="hi,en"

# Optional YouTube authentication. Never commit cookies.txt.
# YT_DLP_COOKIES_FROM_BROWSER="chrome"
# YT_DLP_COOKIES_FILE="cookies.txt"

# Caption styling.
CLIP_CAPTION_FONT="Arial"
CLIP_CAPTION_FONTS_DIR=""
CLIP_CAPTION_FONT_SIZE="96"
CLIP_CAPTION_MARGIN_V="380"
CLIP_CAPTION_COLOUR="&H00FFFFFF"
CLIP_CAPTION_ACTIVE_COLOUR="&H0000E5FF"
CLIP_CAPTION_OUTLINE="6"
CLIP_CAPTION_SHADOW="3"

# Optional source-logo handling: off | crop | delogo.
CLIP_WATERMARK_MODE="off"
CLIP_WATERMARK_REGION="0,0,0.25,0.09"

# Optional n8n publishing. Generation works without this.
N8N_CLIP_WEBHOOK_URL=""
N8N_CLIP_UPLOAD_BUDGET_MB="90"
N8N_CLIP_WEBHOOK_MODE="batch"
