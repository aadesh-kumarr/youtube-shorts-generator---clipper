# =============================================================================
# Clipper.AI — local development configuration
# =============================================================================
# Copy this file to .env.local. Never put real secrets in .env.example and
# never commit .env.local, cookies.txt, generated clips, or model weights.
#
# PowerShell: Copy-Item .env.example .env.local
# macOS/Linux: cp .env.example .env.local

# ── Required: OpenAI ───────────────────────────────────────────────────────
# Used for viral-moment selection and social metadata generation.
OPENAI_API_KEY="sk-your-key-here"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_MAX_RETRIES="5"

# Optional model overrides. When omitted, both stages use OPENAI_MODEL.
# OPENAI_CLIPPER_MODEL="gpt-5.4"
# OPENAI_METADATA_MODEL="gpt-5.4-mini"

# ── Required local service: Faster-Whisper + face tracking ─────────────────
# The included Python service listens here. It is not a hosted dependency.
WHISPER_BACKEND_URL="http://127.0.0.1:5000"

# Read by whisper-service/server.py. large-v3 gives better multilingual
# accuracy; large-v3-turbo uses less time/VRAM and is a good English-only option.
WHISPER_MODEL="large-v3"
WHISPER_HOTWORDS=""
WHISPER_ALLOWED_LANGUAGES="hi,en"

# ── Optional: YouTube authentication ───────────────────────────────────────
# Public videos often work without cookies. Authentication may be needed for
# age-restricted, private, regional, or rate-limited videos.
# YT_DLP_COOKIES_FROM_BROWSER="chrome"
# YT_DLP_COOKIES_FILE="cookies.txt"

# ── Caption styling ─────────────────────────────────────────────────────────
CLIP_CAPTION_FONT="Arial"
CLIP_CAPTION_FONTS_DIR=""
CLIP_CAPTION_FONT_SIZE="96"
CLIP_CAPTION_MARGIN_V="380"
# ASS subtitle colours use &HAABBGGRR format.
CLIP_CAPTION_COLOUR="&H00FFFFFF"
CLIP_CAPTION_ACTIVE_COLOUR="&H0000E5FF"
CLIP_CAPTION_OUTLINE="6"
CLIP_CAPTION_SHADOW="3"

# ── Optional: source-logo handling ─────────────────────────────────────────
# off | crop | delogo. Keep this off unless you know the logo coordinates.
CLIP_WATERMARK_MODE="off"
# x,y,width,height as fractions of the source frame.
CLIP_WATERMARK_REGION="0,0,0.25,0.09"

# ── Optional: runtime storage ───────────────────────────────────────────────
# The Clipper writes to tmp/ and public/output/. This normally needs no change.
# WORKSPACE_DIR="D:/absolute/path/to/workspace"

# ── Optional: n8n publishing ────────────────────────────────────────────────
# Leave the URL empty to generate and download clips without publishing them.
N8N_CLIP_WEBHOOK_URL=""
N8N_CLIP_UPLOAD_BUDGET_MB="90"
# batch | per-clip
N8N_CLIP_WEBHOOK_MODE="batch"
